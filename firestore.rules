rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCafeAdmin() {
      return request.auth != null
        && request.auth.token.email == 'naziajehan9@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validOrder(orderId) {
      let order = request.resource.data;
      return order.keys().hasAll([
          'id', 'customerId', 'customerName', 'customerPhone',
          'customerAddress', 'items', 'subtotal', 'status',
          'createdAt', 'updatedAt', 'deadlineMinutes', 'notes', 'timeline'
        ])
        && order.keys().hasOnly([
          'id', 'customerId', 'customerName', 'customerPhone',
          'customerAddress', 'items', 'subtotal', 'status',
          'createdAt', 'updatedAt', 'deadlineMinutes', 'notes', 'timeline'
        ])
        && order.id == orderId
        && order.customerId is string
        && order.customerId.size() <= 80
        && order.customerName is string
        && order.customerName.size() > 0
        && order.customerName.size() <= 100
        && order.customerPhone is string
        && order.customerPhone.size() >= 10
        && order.customerPhone.size() <= 20
        && order.customerAddress is string
        && order.customerAddress.size() > 0
        && order.customerAddress.size() <= 400
        && order.items is list
        && order.items.size() > 0
        && order.items.size() <= 50
        && order.subtotal is number
        && order.subtotal > 0
        && order.subtotal <= 1000000
        && order.status == 'Pending'
        && order.createdAt is string
        && order.updatedAt is string
        && order.deadlineMinutes == 45
        && order.notes is string
        && order.notes.size() <= 300
        && order.timeline is list
        && order.timeline.size() == 5;
    }

    function validCustomer(customerId) {
      let customer = request.resource.data;
      return customer.keys().hasAll([
          'id', 'name', 'phone', 'email', 'address', 'notes', 'createdAt'
        ])
        && customer.keys().hasOnly([
          'id', 'name', 'phone', 'email', 'address', 'notes', 'createdAt', 'orderId'
        ])
        && customer.id == customerId
        && customer.name is string
        && customer.name.size() > 0
        && customer.name.size() <= 100
        && customer.phone is string
        && customer.phone.size() >= 10
        && customer.phone.size() <= 20
        && customer.email is string
        && customer.email.size() <= 200
        && customer.address is string
        && customer.address.size() > 0
        && customer.address.size() <= 400
        && customer.notes is string
        && customer.notes.size() <= 300
        && customer.createdAt is string;
    }

    match /menu/{itemId} {
      allow read: if true;
      allow write: if isCafeAdmin();
    }

    match /settings/site {
      allow read: if true;
      allow write: if isCafeAdmin();
    }

    match /orders/{orderId} {
      allow create: if validOrder(orderId);
      allow read, update, delete: if isCafeAdmin();
    }

    match /customers/{customerId} {
      allow read, update, delete: if isCafeAdmin();
      allow create: if isCafeAdmin()
        || (
          validCustomer(customerId)
          && request.resource.data.keys().hasAll(['orderId'])
          && existsAfter(
            /databases/$(database)/documents/orders/$(request.resource.data.orderId)
          )
          && getAfter(
            /databases/$(database)/documents/orders/$(request.resource.data.orderId)
          ).data.customerId == customerId
        );
    }
  }
}
