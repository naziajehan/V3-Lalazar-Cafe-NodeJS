rules_version = '2';

service cloud.firestore {
  function isAdmin() {
    return request.auth != null
      && request.auth.token.email == "naziajehan9@gmail.com";
  }

  function isValidCustomer(customer) {
    return customer is map
      && customer.keys().hasAll(["name", "address", "phone", "notes"])
      && customer.keys().hasOnly(["name", "address", "phone", "notes"])
      && customer.name is string
      && customer.name.size() > 0
      && customer.name.size() <= 100
      && customer.address is string
      && customer.address.size() > 0
      && customer.address.size() <= 400
      && customer.phone is string
      && customer.phone.size() >= 10
      && customer.phone.size() <= 20
      && customer.notes is string
      && customer.notes.size() <= 300;
  }

  function isValidMenuItem(data) {
    return data.keys().hasAll([
        "id", "name", "urdu", "description", "price", "category", "image"
      ])
      && data.keys().hasOnly([
        "id", "name", "urdu", "description", "price", "priceFrom",
        "category", "image", "badge", "available"
      ])
      && data.id is int
      && data.id > 0
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 100
      && data.urdu is string
      && data.urdu.size() <= 100
      && data.description is string
      && data.description.size() <= 400
      && data.price is number
      && data.price > 0
      && data.price <= 10000000
      && data.category is string
      && data.category.size() > 0
      && data.category.size() <= 60
      && data.image is string
      && data.image.size() <= 1000
      && (!("priceFrom" in data) || data.priceFrom is bool)
      && (!("badge" in data) || (data.badge is string && data.badge.size() <= 40))
      && (!("available" in data) || data.available is bool);
  }

  function isValidRestaurantSettings(data) {
    return data.keys().hasAll([
        "name", "phone", "address", "hours", "heroTitle", "heroDescription"
      ])
      && data.keys().hasOnly([
        "name", "phone", "address", "hours", "heroTitle", "heroDescription"
      ])
      && data.name is string
      && data.name.size() > 0
      && data.name.size() <= 100
      && data.phone is string
      && data.phone.size() > 0
      && data.phone.size() <= 30
      && data.address is string
      && data.address.size() > 0
      && data.address.size() <= 300
      && data.hours is string
      && data.hours.size() > 0
      && data.hours.size() <= 150
      && data.heroTitle is string
      && data.heroTitle.size() > 0
      && data.heroTitle.size() <= 150
      && data.heroDescription is string
      && data.heroDescription.size() > 0
      && data.heroDescription.size() <= 500;
  }

  function isValidOrder() {
    let data = request.resource.data;
    return data.keys().hasAll(["customer", "items", "subtotal", "status", "createdAt"])
      && data.keys().hasOnly(["customer", "items", "subtotal", "status", "createdAt"])
      && isValidCustomer(data.customer)
      && data.items is list
      && data.items.size() > 0
      && data.items.size() <= 25
      && data.subtotal is number
      && data.subtotal >= 0
      && data.subtotal <= 10000000
      && data.status == "pending"
      && data.createdAt == request.time;
  }

  match /databases/{database}/documents {
    match /menuItems/{menuItemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == "restaurant";
      allow create, update: if isAdmin()
        && settingId == "restaurant"
        && isValidRestaurantSettings(request.resource.data);
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isValidOrder();
      allow update: if isAdmin()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["status"])
            && request.resource.data.status in [
              "pending",
              "confirmed",
              "preparing",
              "completed",
              "cancelled"
            ]
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["customer"])
            && isValidCustomer(request.resource.data.customer)
          )
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
